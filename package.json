{
  "name": "agent-ops-console",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "OPS_CONSOLE_MOCK=1 MOCK_STEP_MS=400 next dev",
    "build": "next build",
    "start": "next start",
    "start:mock": "OPS_CONSOLE_MOCK=1 MOCK_STEP_MS=400 next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:integration": "scripts/integration.sh",
    "screenshots": "SCREENSHOTS=1 playwright test tests/e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "msw": "^3.0.2",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  },
  "description": "Learning project: Next.js operator console for agent-runtime-gcp and mcp-integration-hub.",
  "license": "MIT"
}
